; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NapAttack"
config/description="Action RPG and village life sim (docs/vision/game-design.md)."
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="napattack"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Inputs="*res://core/inputs.gd"
SaveGame="*res://core/save_game.gd"
Quests="*res://core/quests.gd"
Dialogue="*res://core/dialogue.gd"
Zones="*res://core/zones.gd"
Village="*res://core/village.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/world_editor/plugin.cfg")

[layer_names]

2d_physics/layer_1="walls"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="interact"

[phantom_camera]

updater/updater_mode=0

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
