  "after": "a mountain highway post town, in our own style: no real script, invented signs, no modern elements (no power lines, poles or vending machines)",
  "forms": {
   "machiya": "dark weathered timber townhouse, two storeys, wall to wall, lattice front, low deep eaves with a second small eave over the shopfront, hanging lanterns",
   "honjin": "a post-town inn (lodgings for travellers on the pass road)",
   "temple_hall": "the main hall: heavy tiled hipped roof, white plaster and timber frame, on a stone plinth",
   "pagoda": "a five-storey pagoda, the landmark seen from the ways in; vermilion trim",
   "watchkeep": "a small black keep on a battered stone base with a tarn in front, snow on its roofs: the lord's watch on the pass, smaller than Hearthold's keep",
   "minka_thatched": "a steep thatched farmhouse built for snow, on the upper terraces",
   "kura": "a storehouse with white plaster walls and a tiled roof",
   "bathhouse": "the small hot spring bathhouse"
  },
  "colour": "dark roofs and timber, white plaster lines; vermilion only on the temple gate and the pagoda trim",
  "ground": "grey stone paving on Garth Street, raked gravel in the temple court, moss, stone steps, snow above the town"
