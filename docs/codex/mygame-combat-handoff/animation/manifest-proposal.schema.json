{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed per-facing character presentation manifest",
  "description": "Forward handoff only. Cross-field timing/count/anchor checks are additional required runtime validations. Body size and frame quota are deliberately not fixed.",
  "type": "object",
  "required": [
    "id",
    "name",
    "view",
    "frame_size",
    "foot_pivot",
    "clips"
  ],
  "properties": {
    "id": {
      "enum": [
        "bramble",
        "morel",
        "velvet",
        "cairn",
        "iona",
        "tam",
        "brine",
        "pendle",
        "mirra",
        "ashe",
        "clack",
        "nix",
        "rook",
        "mote"
      ]
    },
    "name": {
      "type": "string"
    },
    "view": {
      "enum": [
        "S",
        "N",
        "E",
        "W"
      ]
    },
    "frame_size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "foot_pivot": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "clips": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "frame_count",
          "durations",
          "duration",
          "loop",
          "release_frame",
          "release_time",
          "hold_frame",
          "frames"
        ],
        "properties": {
          "frame_count": {
            "type": "integer",
            "minimum": 1
          },
          "durations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "loop": {
            "type": "boolean"
          },
          "release_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "release_time": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "hold_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "crop_offset": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "stored_size": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "dependentRequired": {
                "crop_offset": [
                  "stored_size"
                ],
                "stored_size": [
                  "crop_offset"
                ]
              },
              "additionalProperties": true
            }
          },
          "release_anchor": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "hand_anchors": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "held_prop_anchors": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "held_prop": {
            "type": "string"
          },
          "held_prop_baked": {
            "type": "boolean"
          },
          "thruster_anchors": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "thruster_direction": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "release_ground_anchor": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "release_height": {
            "type": "number",
            "minimum": 0
          },
          "traversal_frames": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              ]
            }
          },
          "baked_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
