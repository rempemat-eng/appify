{
  "version": 1,
  "status": "Proposal by Claude J, 21 Oct. Data only: nothing reads it at run time until the wiring steps in docs/vision/characters/animation.md land. No game rule depends on it.",
  "units": {
    "world": "Positions, heights and cells are in world px (1x art px). An adult is 25 world px; a cell is 8 world px.",
    "art": "Art px = world px x density. The rig authors at density 2 (an adult about 50 art px, 16 px cells).",
    "rig": "Offsets (dy, dx) are in rig px, the art px at density 2. At density d they become round(value x d / 2); at density 1 a 1 rig px nudge becomes 0 or 1.",
    "ms": "Frame times are real milliseconds at normal speed."
  },
  "densities": [1, 1.5, 2],
  "authorDensity": 2,
  "facings": ["S", "N", "E", "W"],
  "facingRules": {
    "drawnNotMirrored": "W is drawn, never mirrored: the light comes from the upper left in every facing (house-style 3). A mirrored E would put the lit side on the right.",
    "fallback": "When a state is not drawn in the requested facing, it is shown in the first facing it has (react and nap turn the character to face S, towards the player)."
  },
  "phases": {
    "anticipate": "the wind-up: a crouch, a lean or a breath in, against the coming move",
    "act": "the move itself",
    "settle": "overshoot and recovery back to a held pose",
    "hold": "a looping or held pose"
  },
  "rules": [
    "Every state a character starts on its own (walk, react, nap, attack, cast, guard, victory) has an anticipate frame and ends in a settle frame or a hold. States that happen to it (hit, faint) begin with act.",
    "Animation never delays, gates or changes a game callback. The game's timeline leads: when an event arrives, the new state starts at once and the old one is cut.",
    "Effects are finite: each has a frame count and plays once, or loops only while its state is on screen and active. Nothing loops while the screen is inactive.",
    "Every state has a reduced-motion variant: no loops, no translation, no flashes; a held still or a cut.",
    "A frame that is not drawn in a facing is a validation error, never a silent mirror."
  ],
  "walk": {
    "speedWorldPerSec": 40,
    "strideWorld": 24,
    "note": "One walk cycle (two steps, six frames) covers 24 world px, so at the companion's 40 px/s a frame lasts 100 ms. Faster or slower walks scale the frame time (frameMs = 1000 x strideWorld / (speed x frames)) so the feet never slide."
  },
  "cells": {
