    }
  },
  "sheet": {
    "format": "One PNG per character, set and density, a grid of cells `columns` wide, frames in the order the manifest lists them. Nearest-neighbour only. Bundled with import (native-readiness): art/characters/<id>/<set>@<density>x.png plus a generated lib/character-sheets.ts index.",
    "columns": 8,
    "maxSidePx": 2048,
    "manifestPerFrame": [
      "pose",
      "facing",
      "cell index",
      "anchor (foot)",
      "head anchor (hat)",
      "eyes anchor (blink, sleep)",
      "hand anchor (effects spawn)",
      "perch anchor (familiar on the shoulder, fight set only)"
    ],
    "shadow": "Not stored in the sheet. Computed at load from each frame's silhouette by the same rule as the world's cast shadows: thrown east and down, the ground stepped two ramp tones, and a contact line (Claude A ruling, 21 Oct 14:40)."
  },
  "memoryBudgetBytes": {
    "worldScreen": 4194304,
    "fightScreen": 3145728,
    "note": "Decoded RGBA at density 2. A world screen holds the player's folk (world set), the familiar (world set) and up to six residents; a fight holds two fight sets, two perched familiars and the effects."
  },
  "poses": {
    "idle_a": "standing, breath out, weight on both feet; personality in the stance",
    "idle_b": "breath in: chest and head up 1 rig px, arms out a hair",
    "blink": "idle_a with the eyes shut (an overlay painted over the eyes anchor)",
    "fidget_a": "anticipate the character's own beat (each folk's sheet names it)",
    "fidget_b": "the beat, first half",
    "fidget_c": "the beat, second half",
    "fidget_d": "settling back towards idle_a",
    "walk_1": "contact, left foot forward",
    "walk_2": "down: weight sinks onto the left foot, body 1 rig px lower",
    "walk_3": "passing: right foot passes, body at its highest, head a frame behind",
    "walk_4": "contact, right foot forward",
    "walk_5": "down onto the right foot",
    "walk_6": "passing, left foot",
    "react_a": "anticipate: crouch, eyes squeezed, 2 rig px lower",
    "react_b": "act: spring up, arms out",
    "react_c": "act: the happy apex, the character's own gesture",
    "react_d": "settle: land, a small squash",
    "nap_down_a": "anticipate: a yawn and a stretch",
    "nap_down_b": "act: sitting down",
    "nap_down_c": "settle: lying curled, eyes shut",
    "nap_a": "asleep, breath out",
    "nap_b": "asleep, breath in (1 rig px rise at the shoulder)",
    "nap_up_a": "anticipate: stirring, an ear or a hand moves",
    "nap_up_b": "act: sitting up",
    "nap_up_c": "settle: a standing stretch",
    "ready_a": "fight stance, breath out",
    "ready_b": "fight stance, breath in",
    "windup": "anticipate the strike: weight back, weapon drawn",
    "strike_a": "the strike, travelling",
    "strike_b": "the strike at full reach: the impact frame the timed press keys on",
    "cast_a": "anticipate the cast: gathering, the trade's tool raised",
    "cast_b": "the cast released: the effect spawns from the hand anchor",
    "guard": "braced behind arm, shield, wing or shell",
    "hit": "knocked back: head and shoulders thrown away from the foe, eyes shut",
    "sit": "sits down for a breather (the kind faint: no one falls over)",
    "cheer_a": "a small hop, one arm up",
    "cheer_b": "both arms up, at the top",
    "talk_a": "a resident speaking: head tilted, hand raised",
    "talk_b": "the other beat of speech",
    "perch_a": "the familiar on the folk's shoulder, breath out",
    "perch_b": "perched, breath in",
    "cling": "clinging tight when the folk is hit, eyes shut",
    "perch_cheer": "perched, cheering",
    "perch_cast_a": "anticipate the rested special",
    "perch_cast_b": "the special released",
    "hop_1": "familiar hop, crouch",
    "hop_2": "familiar hop, rising",
    "hop_3": "familiar hop, airborne",
    "hop_4": "familiar hop, landing",
    "curl_a": "familiar curled against the folk, asleep",
    "curl_b": "curled, breath in",
    "bow": "a small bow to the other fighter, GOOD MATCH (fights.md 4.7)"
  },
