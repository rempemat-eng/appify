  "machine": {
    "events": {
      "WALK_START": "a walk leg begins (garden-world walkTo, atlas-walk walkTo); carries the leg's facing",
      "FACE": "a new leg turns the walker (runOnJS(setFacing)); carries the facing",
      "ARRIVE": "the walk reached its target (arrived / arrive)",
      "WALK_CANCEL": "the walk was interrupted (stopJourney, a new tap, leaving the screen)",
      "REACT": "a tap, a pat or a garden response (patGuardian, respond)",
      "IDLE_BEAT": "the component's own idle tick fired (today's yawn or look timer)",
      "NAP_START": "the nap action began (act('nap'))",
      "NAP_END": "the nap ended (wake)",
      "FIGHT_ENTER": "the battle screen opened",
      "CARD_ATTACK": "a damaging card resolves (setAttack)",
      "CARD_CAST": "a signature or special card resolves",
      "CARD_GUARD": "a guard card or DEEP BREATH resolves",
      "TAKE_HIT": "an impact lands on this fighter (setHit)",
      "KNOCKED_OUT": "hp reached 0 or the fight was lost",
      "WIN": "the fight ended in this fighter's favour",
      "FIGHT_EXIT": "the battle screen closed",
      "SCREEN_INACTIVE": "the screen lost focus, the app went to the background or the component unmounted",
      "SCREEN_ACTIVE": "the screen is active again",
      "STILL_TURN": "a turn with no damaging card banks a stack (fights.md 4.2)",
      "BOW": "the fight is over and both fighters bow (GOOD MATCH)"
    },
